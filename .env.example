# 로깅
LOGGING_MODE=info
LOGGER_NAME=app

# PostgreSQL 컨테이너 (docker-compose.yaml 에서 사용)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=board

# 데이터베이스 (위 값과 맞춰서 작성)
DATABASE_URL=postgresql+asyncpg://postgres:change-me-db-password@localhost:5432/board
CONNECTION_POOL_SIZE=10
CONNECTION_POOL_MAX_SIZE=20
SQL_ECHO=False

# JWT (HS512 → 64바이트 이상 랜덤 문자열 권장)
JWT_SECRET_KEY=change-me-to-a-64-bytes-or-longer-random-string
JWT_EXPIRE_MINUTES=60

# 서버 시작 시 자동 생성할 관리자 계정 (선택)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Adm1n!
