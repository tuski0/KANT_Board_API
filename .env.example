# 로깅
LOGGING_MODE=info
LOGGER_NAME=app

# 데이터베이스
# docker-compose.yaml 의 POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 와 같은 값 (admin / qwer1234 / board)
DATABASE_URL=postgresql+asyncpg://admin:qwer1234@localhost:5432/board
CONNECTION_POOL_SIZE=10
CONNECTION_POOL_MAX_SIZE=20
SQL_ECHO=False

# JWT 서명 키 (secrets.token_urlsafe(64) 로 생성한 무작위 문자열)
JWT_SECRET_KEY=AWr9qtq_7dPkRag8MZFPDC4QeqUDInlBW7w2nB3FqojNWWuYXO8-GXTAuUx4IexQnlTqOmBlLPTOmOe-jSoiiA
JWT_EXPIRE_MINUTES=60

# 서버 시작 시 자동 생성할 관리자 계정
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@801dda4f1
